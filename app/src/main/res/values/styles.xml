<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/tw_primary</item>
        <item name="android:statusBarColor">@color/tw_bg</item>
        <item name="android:navigationBarColor">@color/tw_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/tw_bg</item>
        <item name="android:alertDialogTheme">@style/TrailwatchAlertDialog</item>
    </style>

    <style name="TrailwatchAlertDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/tw_primary</item>
        <item name="android:colorBackground">@color/tw_surface</item>
        <item name="android:textColorPrimary">@color/tw_text_primary</item>
        <item name="android:textColorSecondary">@color/tw_text_secondary</item>
        <item name="android:windowBackground">@drawable/tw_dialog_background</item>
    </style>

    <style name="TextAppearanceTrailwatchScreenTitle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textColor">@color/tw_text_primary</item>
    </style>
    <style name="TextAppearanceTrailwatchCardTitle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/tw_text_primary</item>
    </style>
    <style name="TextAppearanceTrailwatchHeader">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/tw_text_primary</item>
    </style>
    <style name="TextAppearanceTrailwatchBody">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/tw_text_primary</item>
    </style>
    <style name="TextAppearanceTrailwatchCaption">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/tw_text_secondary</item>
    </style>
    <style name="TextAppearanceTrailwatchLabel">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/tw_text_secondary</item>
    </style>

    <style name="WidgetTrailwatchField">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/tw_text_primary</item>
        <item name="android:textColorHint">@color/tw_hint</item>
        <item name="android:background">@drawable/tw_field</item>
        <item name="android:minHeight">@dimen/tw_target_min</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>
    <style name="WidgetTrailwatchButton">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">@dimen/tw_target_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="TrailwatchCard">
        <item name="android:background">@drawable/tw_card</item>
        <item name="android:padding">@dimen/tw_card_padding</item>
    </style>
    <style name="TrailwatchLabel" parent="TextAppearanceTrailwatchLabel">
        <item name="android:letterSpacing">0.09</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="WidgetTrailwatchPrimaryButton" parent="WidgetTrailwatchButton">
        <item name="android:background">@drawable/tw_button_primary</item>
        <item name="android:textColor">@color/tw_on_primary</item>
    </style>
    <style name="WidgetTrailwatchGhostButton" parent="WidgetTrailwatchButton">
        <item name="android:background">@drawable/tw_button_ghost</item>
        <item name="android:textColor">@color/tw_text_primary</item>
    </style>
    <style name="WidgetTrailwatchSOSButton" parent="WidgetTrailwatchButton">
        <item name="android:background">@drawable/tw_button_sos</item>
        <item name="android:textColor">@color/tw_on_sos</item>
        <item name="android:minHeight">@dimen/tw_button_sos_height</item>
    </style>
</resources>
